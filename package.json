{
  "name": "louvre-heist",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev:server & npm run dev:client",
    "dev:client": "npm run dev --workspace=@louvre-heist/client",
    "dev:server": "npm run dev --workspace=@louvre-heist/server",
    "build": "npm run build --workspaces",
    "build:client": "npm run build --workspace=@louvre-heist/client",
    "build:server": "npm run build --workspace=@louvre-heist/server"
  },
  "devDependencies": {
    "typescript": "^5.3.3"
  }
}
